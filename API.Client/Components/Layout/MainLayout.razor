@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

<div class="page flex-column" dir="rtl">
    <!-- סרגל עליון משותף לכל דפי האתר -->
    <header class="w-100 bg-white border-bottom shadow-sm px-4 py-3 d-flex justify-content-between align-items-center">
        <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
            <span class="bg-primary text-white px-2 py-1 rounded-3 fw-bold">ShiftMaster</span>
            <span class="text-muted small d-none d-sm-inline">ניהול משמרות</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            @if (Session.IsLoggedIn)
            {
                <span class="fw-semibold text-dark">שלום, @Session.Username</span>
                <button class="btn btn-outline-danger btn-sm" type="button" @onclick="Logout">יציאה</button>
            }
            else
            {
                <span class="fw-semibold text-secondary">שלום, אורח</span>
                <a class="btn btn-outline-primary btn-sm" href="login">כניסה</a>
                <a class="btn btn-primary btn-sm" href="register">הרשמה</a>
            }
        </div>
    </header>

    <main class="w-100 p-0">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }
}