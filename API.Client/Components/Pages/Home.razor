@page "/"
@inject UserSession Session
@inject NavigationManager Nav

@* דף הבית הראשי של מערכת ShiftMaster בעיצוב כהה ומודרני *@
<div class="sm-dark-landing px-3 px-md-5 py-4" dir="rtl">
    <div class="sm-glow-blob-1"></div>
    <div class="sm-glow-blob-2"></div>

    <div class="container position-relative" style="max-width: 1200px; z-index: 2;">

        <!-- חלק עליון: Hero Section -->
        <section class="text-center py-4 py-md-5">
            <div class="sm-hero-badge mb-4">
                <span class="material-symbols-outlined fs-6" style="color: #4cd7f6;">bolt</span>
                <span>הדור הבא של סידור העבודה</span>
            </div>

            <h1 class="display-4 fw-bold mb-3 text-white">
                הדרך החכמה לנהל
                <span class="sm-gradient-text d-block d-md-inline">משמרות וצוותים</span>
                בזמן אמת
            </h1>

            <p class="lead mx-auto mb-4" style="max-width: 680px; color: #c7c4d7;">
                פלטפורמה חכמה לשיבוץ משמרות, ניהול אילוצי עובדים וסנכרון זמינות בזמן אמת –
                הכל בממשק אחד מהיר, מדויק ומותאם לארגון שלכם.
            </p>

            <!-- כפתורי פעולה בהתאם למצב ההתחברות -->
            <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 mb-5">
                @if (Session.IsLoggedIn)
                {
                    <div class="sm-dark-card py-3 px-4 d-flex align-items-center gap-3">
                        <span class="material-symbols-outlined" style="color: #4cd7f6;">verified_user</span>
                        <span class="fw-semibold">שלום, <strong>@Session.Username</strong>! אתה מחובר למערכת.</span>
                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="Logout">התנתקות</button>
                    </div>
                }
                else
                {
                    <a href="/register" class="sm-btn-glow">
                        <span>התחל עכשיו בחינם</span>
                        <span class="material-symbols-outlined fs-5">arrow_back</span>
                    </a>
                    <a href="/login" class="sm-btn-dark-secondary">
                        <span class="material-symbols-outlined fs-5" style="color: #4cd7f6;">login</span>
                        <span>התחברות לחשבון</span>
                    </a>
                }
            </div>
        </section>

        <!-- תצוגה מקדימה של לוח שיבוצים שבועי -->
        <section class="sm-dark-panel mb-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined" style="color: #c0c1ff;">calendar_view_week</span>
                    <h5 class="mb-0 fw-bold text-white">לוח שיבוצים שבועי לדוגמה</h5>
                    <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(87, 27, 193, 0.45); color: #d0bcff;">סניף מרכז</span>
                </div>
                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6;">
                    שיבוץ חכם פעיל ✓
                </span>
            </div>

            <!-- כרטיסי KPI -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card">
                        <div class="small" style="color: #c7c4d7;">אחוז איוש שבועי</div>
                        <div class="fs-3 fw-bold text-white my-1">98.4%</div>
                        <div class="small" style="color: #4cd7f6;">+2.3% מהשבוע הקודם</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card">
                        <div class="small" style="color: #c7c4d7;">משמרות מאוישות</div>
                        <div class="fs-3 fw-bold text-white my-1">24 / 24</div>
                        <div class="small" style="color: #c0c1ff;">כל העמדות סגורות</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card">
                        <div class="small" style="color: #c7c4d7;">התנגשויות שיבוץ</div>
                        <div class="fs-3 fw-bold text-white my-1">0</div>
                        <div class="small" style="color: #c7c4d7;">עמידה מלאה באילוצים</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card">
                        <div class="small" style="color: #c7c4d7;">זמן בניית סידור</div>
                        <div class="fs-3 fw-bold text-white my-1">3 דק׳</div>
                        <div class="small" style="color: #4cd7f6;">חיסכון של 85% בזמן</div>
                    </div>
                </div>
            </div>

            <!-- טבלת משמרות לדוגמה -->
            <div class="table-responsive">
                <table class="sm-dark-table">
                    <thead>
                        <tr>
                            <th>עובד / תפקיד</th>
                            <th>יום ראשון</th>
                            <th>יום שני</th>
                            <th>יום שלישי</th>
                            <th>סטטוס שבועי</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="fw-bold text-white">אליאור לוי</div>
                                <div class="small" style="color: #c7c4d7;">אחראי משמרת</div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-primary">
                                    <div class="fw-bold small" style="color: #c0c1ff;">08:00 - 16:30</div>
                                    <div class="small" style="color: #c7c4d7;">משמרת בוקר</div>
                                </div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-off small">חופש מתוכנן</div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-primary">
                                    <div class="fw-bold small" style="color: #c0c1ff;">16:00 - 00:00</div>
                                    <div class="small" style="color: #c7c4d7;">משמרת ערב</div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(0, 158, 185, 0.3); color: #4cd7f6;">מאויש מלא</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="fw-bold text-white">שירה כהן</div>
                                <div class="small" style="color: #c7c4d7;">נציגת שירות</div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-tertiary">
                                    <div class="fw-bold small" style="color: #4cd7f6;">16:00 - 00:00</div>
                                    <div class="small" style="color: #c7c4d7;">משמרת ערב</div>
                                </div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-primary">
                                    <div class="fw-bold small" style="color: #c0c1ff;">08:00 - 16:30</div>
                                    <div class="small" style="color: #c7c4d7;">משמרת בוקר</div>
                                </div>
                            </td>
                            <td>
                                <div class="sm-shift-pill-tertiary">
                                    <div class="fw-bold small" style="color: #4cd7f6;">08:00 - 16:30</div>
                                    <div class="small" style="color: #c7c4d7;">החלפה אושרה ✓</div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(128, 131, 255, 0.3); color: #c0c1ff;">מאושר</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 3 כרטיסי יתרונות -->
        <section class="py-3">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-white">כל הכלים לניהול משמרות ללא פשרות</h2>
                <p style="color: #c7c4d7;">שילוב של נוחות לעובדים ושליטה מלאה למנהלים</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="sm-dark-card">
                        <span class="material-symbols-outlined fs-1 mb-3" style="color: #c0c1ff;">event_available</span>
                        <h4 class="fw-bold text-white mb-2">ניהול אילוצים חכם</h4>
                        <p class="small mb-0" style="color: #c7c4d7;">
                            עובדים מגישים זמינות ואילוצים בקלות, והמערכת מונעת התנגשויות בשיבוץ באופן אוטומטי.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="sm-dark-card">
                        <span class="material-symbols-outlined fs-1 mb-3" style="color: #d0bcff;">monitoring</span>
                        <h4 class="fw-bold text-white mb-2">לוח משמרות בזמן אמת</h4>
                        <p class="small mb-0" style="color: #c7c4d7;">
                            צפייה מיידית במשמרות השבועיות, זיהוי חוסרי איוש ועדכון שוטף לכל חברי הצוות.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="sm-dark-card">
                        <span class="material-symbols-outlined fs-1 mb-3" style="color: #4cd7f6;">admin_panel_settings</span>
                        <h4 class="fw-bold text-white mb-2">הרשאות עובדים ומנהלים</h4>
                        <p class="small mb-0" style="color: #c7c4d7;">
                            הפרדה מלאה בין תצוגת עובד, מנהל משמרת ומנהל מערכת לשמירה על סדר ואבטחה.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="mt-5 pt-4 border-top border-secondary border-opacity-25 text-center small" style="color: #908fa0;">
            © 2026 ShiftMaster — מערכת ניהול ושיבוץ משמרות חכמה
        </footer>
    </div>
</div>

@code {
    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }
}