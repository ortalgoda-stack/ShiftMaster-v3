                                <td class="rounded-3 p-2" style="background-color: #1c1f29;">
                                    <span class="badge rounded-pill mb-2" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6; font-size: 0.7rem;">2/2 מאויש</span>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 small text-white" style="background-color: #0a0e17;">איתי ברנע</div>
