@page "/manager/shifts"
@using API.Client.Services
@inject UserSession Session
@inject NavigationManager Navigation

@* דף ניהול משמרות ולוח שיבוצים (מנהל משמרת ומנהל מערכת) - מטריצת שיבוצים שבועית בעיצוב כהה *@
@if (isAuthorized)
{
    <div class="sm-dark-landing p-3 p-md-4" dir="rtl">
        <div class="sm-glow-blob-1"></div>
        <div class="sm-glow-blob-2"></div>

        <div class="container-fluid position-relative" style="max-width: 1400px; z-index: 2;">

            @* פס ניווט וסטטוס סנכרון *@
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex align-items-center gap-2 small" style="color: #c7c4d7;">
                    <a href="@(Session.RoleId == 1 ? "/admin" : "/manager")"
                       class="text-decoration-none d-inline-flex align-items-center gap-1"
                       style="color: #908fa0;">
                        <span class="material-symbols-outlined fs-6">arrow_forward</span>
                        <span>חזרה ללוח הבקרה</span>
                    </a>
                    <span style="color: #464554;">|</span>
                    <span style="color: #4cd7f6;">ניהול משמרות ושיבוצים</span>
                </div>

                <div class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2"
                     style="background-color: #262a34; color: #dfe2ef;">
                    <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #4cd7f6; box-shadow: 0 0 8px #4cd7f6;"></span>
                    <span>שבוע 44 פתוח לעריכה • סנכרון נתונים פעיל</span>
                </div>
            </div>

            @* באנר כותרת וכפתורי פעולה *@
            <section class="sm-dark-panel mb-4">
                <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-end gap-4">
                    <div>
                        <h1 class="fw-bold text-white mb-2">ניהול משמרות ולוח שיבוצים</h1>
                        <p class="mb-0" style="color: #c7c4d7; max-width: 680px;">
                            תכנון שבועי, איוש עמדות ומעקב אילוצים בזמן אמת בליווי שיבוץ חכם.
                        </p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="sm-btn-dark-secondary">
                            <span class="material-symbols-outlined fs-5" style="color: #908fa0;">file_download</span>
                            <span>ייצוא לוח</span>
                        </button>
                        <button type="button" class="sm-btn-dark-secondary">
                            <span class="material-symbols-outlined fs-5" style="color: #4cd7f6;">auto_awesome</span>
                            <span style="color: #4cd7f6;">שיבוץ חכם (AI)</span>
                        </button>
                        <button type="button" class="sm-btn-dark-secondary">
                            <span class="material-symbols-outlined fs-5" style="color: #c0c1ff;">send</span>
                            <span>פרסום לוח שבועי</span>
                        </button>
                        <button type="button" class="sm-btn-glow">
                            <span class="material-symbols-outlined fs-5">add</span>
                            <span>יצירת משמרת חדשה</span>
                        </button>
                    </div>
                </div>

                @* סרגל ניווט שבועי, בחירת סניף ותצוגות *@
                <div class="row g-3 align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                    <div class="col-12 col-lg-5">
                        <div class="d-flex align-items-center justify-content-between rounded-3 p-1"
                             style="background-color: #0a0e17;">
                            <button type="button" class="btn btn-sm text-secondary border-0" title="שבוע קודם">
                                <span class="material-symbols-outlined fs-5">chevron_right</span>
                            </button>
                            <div class="d-flex align-items-center gap-2 small">
                                <span class="material-symbols-outlined fs-5" style="color: #c0c1ff;">calendar_month</span>
                                <span class="fw-bold text-white">שבוע 44: 27 אוק׳ – 02 נוב׳</span>
                                <span class="badge rounded-pill" style="background-color: rgba(128, 131, 255, 0.25); color: #c0c1ff;">נוכחי</span>
                            </div>
                            <button type="button" class="btn btn-sm text-secondary border-0" title="שבוע הבא">
                                <span class="material-symbols-outlined fs-5">chevron_left</span>
                            </button>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="input-group sm-dark-input-group">
                            <span class="input-group-text">
                                <span class="material-symbols-outlined fs-5" style="color: #4cd7f6;">domain</span>
                            </span>
                            <select class="form-select">
                                <option value="main" style="background-color: #181b25;">סניף תל אביב – מוקד ראשי</option>
                                <option value="support" style="background-color: #181b25;">מוקד שירות ותמיכה טכנית</option>
                                <option value="vip" style="background-color: #181b25;">מוקד לקוחות VIP</option>
                                <option value="logistics" style="background-color: #181b25;">מרכז תפעול ולוגיסטיקה</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3 d-flex justify-content-lg-end">
                        <div class="d-inline-flex gap-1 p-1 rounded-3" style="background-color: #0a0e17;">
                            <span class="badge px-3 py-2 rounded-2 d-inline-flex align-items-center gap-1"
                                  style="background-color: #8083ff; color: #1000a9;">
                                <span class="material-symbols-outlined" style="font-size: 15px;">view_week</span>
                                <span>שבועי</span>
                            </span>
                            <span class="badge px-2 py-2 d-inline-flex align-items-center gap-1" style="color: #908fa0;">
                                <span class="material-symbols-outlined" style="font-size: 15px;">view_day</span>
                                <span>יומי</span>
                            </span>
                            <span class="badge px-2 py-2 d-inline-flex align-items-center gap-1" style="color: #908fa0;">
                                <span class="material-symbols-outlined" style="font-size: 15px;">view_list</span>
                                <span>רשימה</span>
                            </span>
                        </div>
                    </div>
                </div>
            </section>

            @* 4 כרטיסי KPI מרכזיים *@
            <section class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small" style="color: #c7c4d7;">סה״כ משמרות מתוכננות</div>
                            <div class="fs-2 fw-bold text-white mt-1">42</div>
                        </div>
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                             style="background-color: #262a34; color: #c0c1ff;">
                            <span class="material-symbols-outlined fs-3">calendar_view_week</span>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small" style="color: #c7c4d7;">מאוישות בהצלחה</span>
                                <span class="badge rounded-pill" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6; font-size: 0.7rem;">90%</span>
                            </div>
                            <div class="fs-2 fw-bold mt-1" style="color: #4cd7f6;">38</div>
                        </div>
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                             style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6;">
                            <span class="material-symbols-outlined fs-3">how_to_reg</span>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card d-flex justify-content-between align-items-center"
                         style="border-color: rgba(255, 180, 171, 0.35);">
                        <div>
                            <div class="small fw-semibold" style="color: #ffb4ab;">חסרות איוש / דרוש עובד</div>
                            <div class="fs-2 fw-bold mt-1" style="color: #ffb4ab;">4</div>
                        </div>
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                             style="background-color: rgba(147, 0, 10, 0.35); color: #ffb4ab;">
                            <span class="material-symbols-outlined fs-3">warning</span>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="sm-dark-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small" style="color: #c7c4d7;">אילוצים ובקשות פתוחות</div>
                            <div class="fs-2 fw-bold mt-1" style="color: #d0bcff;">5</div>
                        </div>
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                             style="background-color: rgba(87, 27, 193, 0.35); color: #d0bcff;">
                            <span class="material-symbols-outlined fs-3">rule</span>
                        </div>
                    </div>
                </div>
            </section>

            @* מטריצת שיבוצים שבועית 7 ימים (ראשון - שבת) *@
            <section class="sm-dark-panel p-3">
                <div class="table-responsive">
                    <table class="table table-borderless align-top mb-0" style="min-width: 1200px; border-collapse: separate; border-spacing: 8px;">
                        <thead>
                            <tr>
                                <th class="rounded-3 p-3 align-middle" style="width: 165px; background-color: #262a34; color: #dfe2ef;">
                                    <div class="d-flex align-items-center gap-2 small fw-bold">
                                        <span class="material-symbols-outlined fs-5" style="color: #908fa0;">layers</span>
                                        <span>משמרת \ יום</span>
                                    </div>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold text-white">ראשון</div>
                                    <small style="color: #908fa0;">27 אוקטובר</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold text-white">שני</div>
                                    <small style="color: #908fa0;">28 אוקטובר</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold text-white">שלישי</div>
                                    <small style="color: #908fa0;">29 אוקטובר</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: rgba(128, 131, 255, 0.25); border: 1px solid rgba(192, 193, 255, 0.3);">
                                    <div class="fw-bold" style="color: #c0c1ff;">רביעי</div>
                                    <small style="color: #e1e0ff;">30 אוקטובר (היום)</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold text-white">חמישי</div>
                                    <small style="color: #908fa0;">31 אוקטובר</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold" style="color: #c7c4d7;">שישי</div>
                                    <small style="color: #4cd7f6;">01 נוב׳ • מקוצר</small>
                                </th>
                                <th class="rounded-3 p-2 text-center" style="background-color: #0a0e17;">
                                    <div class="fw-bold" style="color: #c7c4d7;">שבת</div>
                                    <small style="color: #d0bcff;">02 נוב׳ • כוננות</small>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @* שורה 1: משמרת בוקר *@
                            <tr>
                                <td class="rounded-3 p-3" style="background-color: #1c1f29;">
                                    <div class="d-flex align-items-center gap-1 fw-bold text-white mb-1">
                                        <span class="material-symbols-outlined fs-5" style="color: #c0c1ff;">light_mode</span>
                                        <span>משמרת בוקר</span>
                                    </div>
                                    <div class="small mb-2" style="color: #4cd7f6;">08:00 - 16:30</div>
                                    <span class="badge rounded-2" style="background-color: #31353f; color: #c7c4d7;">דרישה: 3 עובדים</span>
                                </td>

                                @* ראשון בוקר *@
                                <td class="rounded-3 p-2" style="background-color: #1c1f29;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge rounded-pill" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6; font-size: 0.7rem;">3/3 מאויש</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 d-flex justify-content-between align-items-center" style="background-color: #0a0e17;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #c0c1ff; color: #1000a9;">דב</span>
                                                <div class="lh-1">
                                                    <div class="small fw-semibold text-white">דן בן-דוד</div>
                                                    <small style="color: #c0c1ff; font-size: 0.65rem;">אחמ״ש</small>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined" style="font-size: 14px; color: #c0c1ff;">star</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #571bc1; color: #c4abff;">שכ</span>
                                            <span class="small text-white">שירה כהן</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">נג</span>
                                            <span class="small text-white">נועה גולן</span>
                                        </div>
                                    </div>
                                </td>

                                @* שני בוקר *@
                                <td class="rounded-3 p-2" style="background-color: #1c1f29;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge rounded-pill" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6; font-size: 0.7rem;">3/3 מאויש</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 d-flex justify-content-between align-items-center" style="background-color: #0a0e17;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #c0c1ff; color: #1000a9;">רק</span>
                                                <div class="lh-1">
                                                    <div class="small fw-semibold text-white">רועי קליין</div>
                                                    <small style="color: #c0c1ff; font-size: 0.65rem;">אחמ״ש</small>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined" style="font-size: 14px; color: #c0c1ff;">star</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">אמ</span>
                                            <span class="small text-white">איתי מזרחי</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">לש</span>
                                            <span class="small text-white">לירון שפירא</span>
                                        </div>
                                    </div>
                                </td>

                                @* שלישי בוקר *@
                                <td class="rounded-3 p-2" style="background-color: #1c1f29;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge rounded-pill" style="background-color: rgba(0, 158, 185, 0.25); color: #4cd7f6; font-size: 0.7rem;">3/3 מאויש</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 d-flex justify-content-between align-items-center" style="background-color: #0a0e17;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #c0c1ff; color: #1000a9;">דב</span>
                                                <div class="lh-1">
                                                    <div class="small fw-semibold text-white">דן בן-דוד</div>
                                                    <small style="color: #c0c1ff; font-size: 0.65rem;">אחמ״ש</small>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined" style="font-size: 14px; color: #c0c1ff;">star</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">הב</span>
                                            <span class="small text-white">הגר ברק</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">טפ</span>
                                            <span class="small text-white">טל פרידמן</span>
                                        </div>
                                    </div>
                                </td>

                                @* רביעי בוקר (היום) *@
                                <td class="rounded-3 p-2" style="background-color: #262a34; border: 1px solid rgba(128, 131, 255, 0.35);">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge rounded-pill" style="background-color: rgba(0, 158, 185, 0.35); color: #4cd7f6; font-size: 0.7rem;">3/3 פעיל עכשיו</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 d-flex justify-content-between align-items-center" style="background-color: #0a0e17;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #c0c1ff; color: #1000a9;">רק</span>
                                                <div class="lh-1">
                                                    <div class="small fw-semibold text-white">רועי קליין</div>
                                                    <small style="color: #c0c1ff; font-size: 0.65rem;">אחמ״ש</small>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined" style="font-size: 14px; color: #c0c1ff;">star</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">שכ</span>
                                            <span class="small text-white">שירה כהן</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">עא</span>
                                            <span class="small text-white">עומר אלוני</span>
                                        </div>
                                    </div>
                                </td>

                                @* חמישי בוקר (חסר עובד!) *@
                                <td class="rounded-3 p-2" style="background-color: rgba(147, 0, 10, 0.25); border: 1px solid rgba(255, 180, 171, 0.35);">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge rounded-pill fw-bold" style="background-color: rgba(255, 180, 171, 0.2); color: #ffb4ab; font-size: 0.7rem;">2/3 חסר עובד!</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="rounded-2 p-2 d-flex justify-content-between align-items-center" style="background-color: #0a0e17;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #c0c1ff; color: #1000a9;">דב</span>
                                                <div class="lh-1">
                                                    <div class="small fw-semibold text-white">דן בן-דוד</div>
                                                    <small style="color: #c0c1ff; font-size: 0.65rem;">אחמ״ש</small>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined" style="font-size: 14px; color: #c0c1ff;">star</span>
                                        </div>
                                        <div class="rounded-2 p-2 d-flex align-items-center gap-2" style="background-color: #0a0e17;">
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.65rem; background-color: #31353f; color: #dfe2ef;">נג</span>
