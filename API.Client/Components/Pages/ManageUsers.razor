@page "/admin/users"
@using API.Client.Services
@inject UserSession Session
@inject NavigationManager Navigation

@* דף ניהול משתמשים והרשאות (Admin בלבד) בעיצוב כהה ומודרני מבוסס Stitch *@
@if (isAuthorized)
{
    <div class="sm-dark-landing p-3 p-md-4" dir="rtl">
        <div class="sm-glow-blob-1"></div>
        <div class="sm-glow-blob-2"></div>

        <div class="container-fluid position-relative" style="max-width: 1320px; z-index: 2;">

            @* פס ניווט וסטטוס סנכרון חי *@
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex align-items-center gap-2 small" style="color: #c7c4d7;">
                    <a href="/admin" class="text-decoration-none d-inline-flex align-items-center gap-1" style="color: #908fa0;">
                        <span class="material-symbols-outlined fs-6">arrow_forward</span>
                        <span>חזרה לדשבורד מנהל</span>
                    </a>
                    <span style="color: #464554;">|</span>
                    <span style="color: #4cd7f6;">ניהול משתמשים והרשאות ארגוניות</span>
                </div>

                <div class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2"
                     style="background-color: #262a34; color: #dfe2ef;">
                    <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #4cd7f6; box-shadow: 0 0 8px #4cd7f6;"></span>
                    <span>מסד נתונים מסונכרן בזמן אמת</span>
                </div>
            </div>

            @* באנר כותרת וכפתורי פעולה *@
            <section class="sm-dark-panel mb-4">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                    <div>
                        <h1 class="fw-bold text-white mb-2">ניהול עובדים והרשאות</h1>
                        <p class="mb-0" style="color: #c7c4d7; max-width: 680px;">
                            ניהול מצבת העובדים, הגדרת הרשאות גישה לתפקידים שונים (מנהל מערכת, מנהל משמרת, עובד) ומעקב סטטוס בזמן אמת.
                        </p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="sm-btn-dark-secondary">
                            <span class="material-symbols-outlined fs-5" style="color: #4cd7f6;">sync</span>
