                    <div class="col-6 col-md-4 col-xl">
                        <div class="rounded-4 p-3 d-flex align-items-center gap-3" style="background-color: #181b25;">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                                 style="background-color: #262a34; color: #c0c1ff;">
                                <span class="material-symbols-outlined fs-4">group</span>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-white lh-1">24</div>
                                <small style="color: #908fa0;">סה״כ עובדים</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl">
                        <div class="rounded-4 p-3 d-flex align-items-center gap-3" style="background-color: #181b25;">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                                 style="background-color: rgba(128, 131, 255, 0.2); color: #c0c1ff;">
                                <span class="material-symbols-outlined fs-4">shield_person</span>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fs-4 fw-bold lh-1" style="color: #c0c1ff;">2</span>
                                    <span class="badge" style="background-color: rgba(128, 131, 255, 0.3); color: #e1e0ff; font-size: 0.65rem;">מלאה</span>
                                </div>
                                <small style="color: #908fa0;">מנהלי מערכת</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl">
                        <div class="rounded-4 p-3 d-flex align-items-center gap-3" style="background-color: #181b25;">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                                 style="background-color: rgba(0, 158, 185, 0.2); color: #4cd7f6;">
                                <span class="material-symbols-outlined fs-4">badge</span>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold lh-1" style="color: #4cd7f6;">3</div>
                                <small style="color: #908fa0;">מנהלי משמרת</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-6 col-xl">
                        <div class="rounded-4 p-3 d-flex align-items-center gap-3" style="background-color: #181b25;">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                                 style="background-color: #262a34; color: #d0bcff;">
                                <span class="material-symbols-outlined fs-4">engineering</span>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-white lh-1">19</div>
                                <small style="color: #908fa0;">עובדים וצוות</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl">
                        <div class="rounded-4 p-3 d-flex align-items-center gap-3" style="background-color: #181b25;">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center"
                                 style="background-color: rgba(245, 158, 11, 0.15); color: #fcd34d;">
                                <span class="material-symbols-outlined fs-4">mark_email_unread</span>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fs-4 fw-bold lh-1" style="color: #fcd34d;">3</span>
                                    <span class="badge" style="background-color: rgba(245, 158, 11, 0.25); color: #fde68a; font-size: 0.65rem;">חדש</span>
                                </div>
                                <small style="color: #908fa0;">הזמנות בהמתנה</small>
                            </div>
                        </div>
                    </div>
