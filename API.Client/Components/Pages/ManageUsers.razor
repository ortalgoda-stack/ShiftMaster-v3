@code {
    // דגל המציין האם המשתמש מורשה לצפות בדף ניהול המשתמשים
    private bool isAuthorized = false;

    protected override void OnInitialized()
    {
        // בדיקת התחברות: אם המשתמש לא מחובר, הפניה לדף הכניסה
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // בדיקת הרשאה: רק מנהל מערכת (RoleId == 1) מורשה לנהל משתמשים והרשאות
        if (Session.RoleId != 1)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        isAuthorized = true;
    }
}