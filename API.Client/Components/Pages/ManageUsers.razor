                                                <span class="material-symbols-outlined fs-6" style="color: #4cd7f6;" title="חשבון מאומת">verified</span>
                                            </div>
                                            <small style="color: #908fa0;">מזהה: #EMP-1001</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace small" style="color: #4cd7f6;">@@israel_y</span>
                                </td>
                                <td style="color: #c7c4d7;">israel@@shiftmaster.io</td>
                                <td>
                                    <span class="badge rounded-2 px-2 py-1" style="background-color: #262a34; color: #dfe2ef;">הנהלה ומערכות</span>
