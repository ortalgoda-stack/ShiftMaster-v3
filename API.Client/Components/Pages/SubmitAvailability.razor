@page "/employee/availability"
@using API.Client.Services
@inject UserSession Session
@inject NavigationManager Navigation

@* דף הגשת זמינות ואילוצים לעובד (Employee) - מטריצה שבועית אינטראקטיבית *@
@if (isAuthorized)
{
    <div class="container-fluid py-3" dir="rtl">

        @* כותרת דף משותפת (רכיב Shared) עם תגית תפקיד *@
        <PageHeader Title="הגשת זמינות ואילוצים"
                    Subtitle="סימון העדפות משמרת, שעות זמינות והגשת אילוצים אישיים לסידור העבודה הקרוב"
                    RoleBadge="עובד מוקד" />

        @* שורת כפתור חזרה לדף הבית של העובד *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/employee" class="btn btn-outline-secondary rounded-3 fw-semibold">
                → חזרה לדף הבית של העובד
            </a>
            <span class="badge bg-light text-secondary border px-3 py-2">
                עובד מחובר: @(Session.Username ?? "דניאל לוי")
            </span>
        </div>

        @* באנר מידע ותזכורת מועד נעילה *@
        <div class="alert alert-primary border-0 rounded-4 shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 p-md-4 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="fs-3">📆</div>
                <div>
                    <div class="fw-bold text-primary-emphasis">
                        הגשה עבור שבוע: 29 באוקטובר – 4 בנובמבר (שבוע 44)
                    </div>
                    <small class="text-secondary">
                        ניתן לעדכן זמינות עד <strong>יום חמישי בשעה 20:00</strong>. לאחר מכן המערכת תינעל לשיבוץ סופי.
                    </small>
                </div>
            </div>
            <span class="badge bg-danger text-white fs-6 px-3 py-2 rounded-pill align-self-start align-self-md-center">
                ⏱️ נותרו 48 שעות להגשה
            </span>
        </div>

        @* הודעת אישור לאחר שליחת הטופס *@
        @if (isSubmitted)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm p-3 mb-4 fw-semibold">
                ✅ הזמינות והאילוצים שלך לשבוע הקרוב נשמרו והוגשו בהצלחה למנהל המשמרת!
            </div>
        }

        @* 3 כרטיסי סיכום המתעדכנים בזמן אמת *@
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <StatCard Title="משמרות שסומנו כזמינות"
                          Value="@AvailableShiftsCount.ToString()"
                          Subtitle="יעד מינימום שבועי: 4 משמרות"
                          Icon="📅"
                          ColorClass="text-primary" />
            </div>
            <div class="col-12 col-md-4">
                <StatCard Title="אילוצים / ימי חופש שהוגשו"
                          Value="@ConstraintsCount.ToString()"
                          Subtitle="ימים שסומנו כלא זמינים"
                          Icon="🚫"
                          ColorClass="text-danger" />
            </div>
            <div class="col-12 col-md-4">
                <StatCard Title="סטטוס טופס שבועי"
                          Value="@(isSubmitted ? "הוגש למנהל" : "טיוטה פתוחה")"
                          Subtitle="ניתן לעדכן עד מועד הנעילה"
                          Icon="📝"
                          ColorClass="@(isSubmitted ? "text-success" : "text-dark")" />
            </div>
        </div>

        @* מטריצת ימי השבוע להגשת זמינות *@
        <div class="sm-card p-3 p-md-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-0">פירוט ימי השבוע ושיבוץ רצוי</h5>
                    <small class="text-muted">ניתן לסמן יותר ממשמרת אחת בכל יום, או לסמן יום כאילוץ</small>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 150px;">יום ותאריך</th>
                            <th>משמרת בוקר (08:00-16:00)</th>
                            <th>משמרת ערב (16:00-00:00)</th>
                            <th>לא זמין / אילוץ</th>
                            <th>הערה ליום זה</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in weekDays)
                        {
                            <tr class="@(day.IsConstraint ? "table-danger" : "")">
                                <td>
                                    <div class="fw-bold">@day.DayName</div>
                                    <small class="text-muted">@day.DateText</small>
                                </td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="m-@day.DayName"
                                               checked="@day.Morning"
                                               disabled="@day.IsConstraint"
                                               @onchange="(e) => ToggleMorning(day, e)" />
                                        <label class="form-check-label small fw-semibold" for="m-@day.DayName">
                                            ☀️ בוקר
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="e-@day.DayName"
                                               checked="@day.Evening"
                                               disabled="@day.IsConstraint"
                                               @onchange="(e) => ToggleEvening(day, e)" />
                                        <label class="form-check-label small fw-semibold" for="e-@day.DayName">
                                            🌙 ערב
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="c-@day.DayName"
                                               checked="@day.IsConstraint"
                                               @onchange="(e) => ToggleConstraint(day, e)" />
                                        <label class="form-check-label small fw-bold text-danger" for="c-@day.DayName">
                                            🚫 אילוץ / חופש
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <input type="text"
                                           class="form-control form-control-sm rounded-3"
                                           placeholder="הערה אופציונלית..."
                                           @bind="day.Note" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* הערות כלליות וכפתור הגשה *@
            <div class="mt-4 pt-3 border-top">
                <label class="form-label fw-semibold">הערות כלליות למנהל המשמרת (אופציונלי)</label>
                <textarea class="form-control rounded-3 mb-3"
                          rows="2"
                          placeholder="לדוגמה: מעדיף לא לשבץ ערב ואחריו בוקר ברצף..."
                          @bind="generalNotes"></textarea>

                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <button type="button" class="btn sm-btn-primary px-4" @onclick="SubmitForm">
                        📤 שמירה והגשת זמינות למנהל
                    </button>
                </div>
            </div>
        </div>

    </div>
}

@code {
    // דגל המציין האם המשתמש מורשה לצפות בדף
    private bool isAuthorized = false;

    // חיווי האם הטופס נשלח
    private bool isSubmitted = false;

    // הערות כלליות למנהל
    private string generalNotes = string.Empty;

    // רשימת ימי השבוע להגשה (נתונים סטטיים התחלתיים לדוגמה)
    private List<DayAvailability> weekDays = new()
    {
        new("יום ראשון", "29/10", true, false, false, ""),
        new("יום שני", "30/10", true, true, false, ""),
        new("יום שלישי", "31/10", false, false, true, "מבחן סמסטר באוניברסיטה עד 13:00"),
        new("יום רביעי", "01/11", true, false, false, ""),
        new("יום חמישי", "02/11", true, true, false, ""),
        new("יום שישי", "03/11", true, false, false, "משמרת בוקר קצרה בלבד"),
        new("שבת", "04/11", false, false, false, "")
    };

    // חישוב דינמי של כמות המשמרות הזמינות שסומנו
    private int AvailableShiftsCount => weekDays.Sum(d => (d.Morning ? 1 : 0) + (d.Evening ? 1 : 0));

    // חישוב דינמי של כמות ימי האילוץ שסומנו
    private int ConstraintsCount => weekDays.Count(d => d.IsConstraint);

    protected override void OnInitialized()
    {
        // בדיקת התחברות
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // בדיקת הרשאה: עובד (RoleId == 2) או מנהל מערכת לבדיקות (RoleId == 1)
        if (Session.RoleId != 2 && Session.RoleId != 1)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        isAuthorized = true;
    }

    private void ToggleMorning(DayAvailability day, ChangeEventArgs e)
    {
        day.Morning = (bool)(e.Value ?? false);
        isSubmitted = false;
    }

    private void ToggleEvening(DayAvailability day, ChangeEventArgs e)
    {
        day.Evening = (bool)(e.Value ?? false);
        isSubmitted = false;
    }

    private void ToggleConstraint(DayAvailability day, ChangeEventArgs e)
    {
        day.IsConstraint = (bool)(e.Value ?? false);
        if (day.IsConstraint)
        {
            // אם סומן אילוץ, מנקים בחירות משמרת באותו יום
            day.Morning = false;
            day.Evening = false;
        }
        isSubmitted = false;
    }

    private void SubmitForm()
    {
        isSubmitted = true;
    }

    // מחלקת עזר פנימית לייצוג שורת יום בטופס
    private class DayAvailability
    {
        public string DayName { get; set; }
        public string DateText { get; set; }
        public bool Morning { get; set; }
        public bool Evening { get; set; }
        public bool IsConstraint { get; set; }
        public string Note { get; set; }

        public DayAvailability(string dayName, string dateText, bool morning, bool evening, bool isConstraint, string note)
        {
            DayName = dayName;
            DateText = dateText;
            Morning = morning;
            Evening = evening;
            IsConstraint = isConstraint;
            Note = note;
        }
    }
}