@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Mail
@using Model
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="sm-dark-landing d-flex align-items-center justify-content-center py-5 px-3" dir="rtl">
    <div class="sm-glow-blob-1"></div>
    <div class="sm-glow-blob-2"></div>

    <div class="sm-auth-card p-4 p-md-5 position-relative" style="max-width: 560px; z-index: 2;">

        <!-- שורה עליונה: חזרה לדף הבית + תגית אבטחה -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/" class="text-decoration-none d-inline-flex align-items-center gap-1 small" style="color: #c7c4d7;">
                <span class="material-symbols-outlined fs-6">arrow_forward</span>
                <span>חזרה לדף הבית</span>
            </a>
            <span class="badge rounded-pill px-2 py-1" style="background-color: rgba(0, 158, 185, 0.2); color: #4cd7f6; font-size: 0.75rem;">
                רישום ארגוני מהיר •
            </span>
        </div>

        <!-- לוגו וכותרת -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3"
                 style="width: 64px; height: 64px; background: linear-gradient(135deg, #571bc1, #8083ff, #009eb9); box-shadow: 0 0 25px rgba(128, 131, 255, 0.45);">
                <span class="material-symbols-outlined text-white fs-2">person_add</span>
            </div>
            <div class="d-flex justify-content-center align-items-center gap-2">
                <span class="fw-bold fs-4 text-white">ShiftMaster</span>
                <span class="badge" style="background-color: rgba(76, 215, 246, 0.15); color: #4cd7f6;">PRO</span>
            </div>
            <h2 class="fw-bold text-white mt-3 mb-1">יצירת חשבון חדש</h2>
            <p class="small mb-0" style="color: #908fa0;">מלאו את הפרטים ליצירת חשבון במערכת ShiftMaster</p>
        </div>

        <!-- בחירת תפקיד במערכת (כמו בעיצוב של Stitch) -->
        <div class="mb-4 text-end">
            <label class="form-label small fw-semibold mb-2" style="color: #dfe2ef;">תפקיד במערכת</label>
            <div class="row g-2">
                <div class="col-6">
                    <button type="button"
                            class="w-100 text-end p-3 rounded-3 border transition-all d-flex align-items-center justify-content-between"
                            style="@(selectedRoleId == 2 ? "background-color: #262a34; border-color: #8083ff !important; box-shadow: 0 0 15px rgba(128,131,255,0.2);" : "background-color: #0a0e17; border-color: rgba(255,255,255,0.1) !important;")"
                            @onclick="() => selectedRoleId = 2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5" style="color: #c0c1ff;">person</span>
                            <div>
                                <div class="fw-bold small text-white">עובד / נציג</div>
                                <div style="font-size: 0.72rem; color: #908fa0;">הגשת אילוצים</div>
                            </div>
                        </div>
                        @if (selectedRoleId == 2)
                        {
                            <span class="material-symbols-outlined fs-6" style="color: #4cd7f6;">check_circle</span>
                        }
                    </button>
                </div>

                <div class="col-6">
                    <button type="button"
                            class="w-100 text-end p-3 rounded-3 border transition-all d-flex align-items-center justify-content-between"
                            style="@(selectedRoleId == 3 ? "background-color: #262a34; border-color: #8083ff !important; box-shadow: 0 0 15px rgba(128,131,255,0.2);" : "background-color: #0a0e17; border-color: rgba(255,255,255,0.1) !important;")"
                            @onclick="() => selectedRoleId = 3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5" style="color: #4cd7f6;">badge</span>
                            <div>
                                <div class="fw-bold small text-white">מנהל משמרת</div>
                                <div style="font-size: 0.72rem; color: #908fa0;">ניהול ושיבוץ</div>
                            </div>
                        </div>
                        @if (selectedRoleId == 3)
                        {
                            <span class="material-symbols-outlined fs-6" style="color: #4cd7f6;">check_circle</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- טופס הרשמה -->
        <div class="row g-3 mb-3 text-end">
            <div class="col-sm-6">
                <label for="reg-fullname" class="form-label small fw-semibold" style="color: #dfe2ef;">שם מלא</label>
                <div class="input-group sm-dark-input-group">
                    <span class="input-group-text">
                        <span class="material-symbols-outlined fs-5">person_outline</span>
                    </span>
                    <input id="reg-fullname" type="text" class="form-control" placeholder="ישראל ישראלי" @bind="fullName" />
                </div>
            </div>

            <div class="col-sm-6">
                <label for="reg-username" class="form-label small fw-semibold" style="color: #dfe2ef;">שם משתמש</label>
                <div class="input-group sm-dark-input-group">
                    <span class="input-group-text">
                        <span class="material-symbols-outlined fs-5">alternate_email</span>
                    </span>
                    <input id="reg-username" type="text" class="form-control" placeholder="israel_y" @bind="username" />
                </div>
            </div>
        </div>

        <div class="mb-3 text-end">
            <label for="reg-email" class="form-label small fw-semibold" style="color: #dfe2ef;">אימייל</label>
            <div class="input-group sm-dark-input-group">
                <span class="input-group-text">
                    <span class="material-symbols-outlined fs-5">mail</span>
                </span>
                <input id="reg-email" type="email" class="form-control" placeholder="name@company.co.il" @bind="email" />
            </div>
        </div>

        <div class="row g-3 mb-4 text-end">
            <div class="col-sm-6">
                <label for="reg-password" class="form-label small fw-semibold" style="color: #dfe2ef;">סיסמה</label>
                <div class="input-group sm-dark-input-group">
                    <span class="input-group-text">
                        <span class="material-symbols-outlined fs-5">lock</span>
                    </span>
                    <input id="reg-password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="••••••••" @bind="password" />
                    <button type="button" class="input-group-text border-0 bg-transparent" @onclick="() => showPassword = !showPassword">
                        <span class="material-symbols-outlined fs-5">@(showPassword ? "visibility_off" : "visibility")</span>
                    </button>
                </div>
            </div>

            <div class="col-sm-6">
                <label for="reg-confirm" class="form-label small fw-semibold" style="color: #dfe2ef;">אימות סיסמה</label>
                <div class="input-group sm-dark-input-group">
                    <span class="input-group-text">
                        <span class="material-symbols-outlined fs-5">verified_user</span>
                    </span>
                    <input id="reg-confirm" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="••••••••" @bind="confirmPassword" />
                </div>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert text-center p-2 rounded-3 small mb-3" role="alert"
                 style="background-color: rgba(147, 0, 10, 0.45); border: 1px solid #ffb4ab; color: #ffdad6;">
                @errorMessage
            </div>
        }

        @if (isRegistered)
        {
            <div class="alert text-center p-2 rounded-3 small mb-3" role="status"
                 style="background-color: rgba(0, 158, 185, 0.25); border: 1px solid #4cd7f6; color: #acedff;">
                <strong>ההרשמה הצליחה!</strong> עוברים לדף הכניסה בעוד @secondsLeft שניות.
            </div>
        }

        <button class="sm-btn-glow w-100 justify-content-center py-3 mb-3" type="button"
                disabled="@(isBusy || isRegistered)" @onclick="RegisterAsync">
            <span class="material-symbols-outlined fs-5">how_to_reg</span>
            <span>@(isBusy ? "בודקים..." : "הרשמה למערכת")</span>
        </button>

        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
            <span class="small" style="color: #c7c4d7;">כבר יש לך חשבון? </span>
            <a href="/login" class="text-decoration-none fw-bold small" style="color: #4cd7f6;">להתחברות ></a>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-2 small mt-4" style="color: #908fa0; font-size: 0.78rem;">
            <span class="material-symbols-outlined fs-6" style="color: #4cd7f6;">lock</span>
            <span>הצפנה ארגונית מאובטחת • ShiftMaster</span>
        </div>
    </div>
</div>

@code {
    private string fullName = "";
    private string username = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private int selectedRoleId = 2; // ברירת מחדל: עובד (2), מנהל משמרת (3)

    private string? errorMessage;
    private bool isBusy = false;
    private bool isRegistered = false;
    private int secondsLeft = 5;
    private bool showPassword = false;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;

        try
        {
            // יצירת אובייקט משתמש חדש מתוך המודל
            User newUser = new User
            {
                Username = username.Trim(),
                Email = email.Trim(),
                Password = password,
                FullName = string.IsNullOrWhiteSpace(fullName) ? username.Trim() : fullName.Trim(),
                RoleId = selectedRoleId
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("api/user/register", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"שגיאת תקשורת: {ex.Message}";
            return;
        }
        finally
        {
            isBusy = false;
        }

        isRegistered = true;
        while (secondsLeft > 0)
        {
            StateHasChanged();
            await Task.Delay(1000);
            secondsLeft--;
        }
        Navigation.NavigateTo("login");
    }
}